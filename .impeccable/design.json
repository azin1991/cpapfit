  "narrative": {
    "northStar": "The Trusted Educator",
    "overview": "The site teaches before it sells. Visitors are tired, often anxious, newly diagnosed or helping someone who is. The design gets out of the way of understanding: readable text at comfortable widths, numbered steps, plain callouts, and the two clinic phone numbers never more than a tap away.\n\nSurfaces are soft and quiet. White cards with a faint blue-tinted shadow and gently rounded corners sit on a warm off-white page. Deep navy carries headings and the main actions; the logo green appears only in small accents. Nothing flashes, nothing pressures.\n\nCopy is real text, never baked into images (the three licensed hero photos are the one exception), so every page can be translated for the planned Chinese version.",
    "keyCharacteristics": [
      "Warm off-white page, white cards, faint blue shadow",
      "Deep navy headings, clinic-blue actions, green used sparingly",
      "Plus Jakarta Sans headings, Inter body text",
      "Reading width capped at 720px; content at 1240px",
      "Functional icons only (menu, phone, location, warning, accordion)"
    ],
    "rules": [
      {
        "name": "The Quiet Green Rule",
        "body": "Logo Green is an accent, never a fill for large areas, buttons or text. If green is on more than a few small marks per screen, it is too much.",
        "section": "colors"
      },
      {
        "name": "The Readable Label Rule",
        "body": "Small text (under 18px) uses Slate or darker. Pewter fails contrast on Linen.",
        "section": "colors"
      },
      {
        "name": "The Real Text Rule",
        "body": "Headlines and slogans are HTML text, not images, so they can be read aloud and translated.",
        "section": "typography"
      },
      {
        "name": "The Faint Shadow Rule",
        "body": "Shadows only hint at a surface. If a shadow is the first thing you notice, it is too strong.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep both clinic phone numbers one tap away on every page.",
      "Do cap reading text at 720px and use numbered steps for processes.",
      "Do use Slate or darker for any text under 18px.",
      "Do keep every heading and slogan as real text so it can be translated.",
      "Do honour reduced-motion settings; animations become instant."
    ],
    "donts": [
      "Don't show office hours anywhere.",
      "Don't add patient counts, star ratings, \"verified\" badges, statistics or other claims the clinic has not confirmed.",
      "Don't add decorative icons; icons must do a job (menu, phone, location, warning, accordion).",
      "Don't use Logo Green for buttons, large fills or body text.",
      "Don't use the red alert style for anything except genuine safety warnings."
    ]
  }
}